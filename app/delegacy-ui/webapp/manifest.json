{
  "_version": "1.86.0",
  "sap.app": {
    "id": "delegacy-ui",
    "type": "application",
    "i18n": {
      "bundleUrl": "i18n/i18n.properties",
      "supportedLocales": [
        "",
        "hu"
      ],
      "fallbackLocale": ""
    },
    "applicationVersion": {
      "version": "0.0.1"
    },
    "title": "{{appTitle}}",
    "description": "{{appDescription}}",
    "resources": "resources.json",
    "sourceTemplate": {
      "id": "@sap/generator-fiori:fpm",
      "version": "1.30.0",
      "toolsId": "9e5687a9-53e8-465d-b3f5-dd3b59db7ef9"
    },
    "dataSources": {
      "mainService": {
        "uri": "/odata/v4/app/",
        "type": "OData",
        "settings": {
          "annotations": [],
          "odataVersion": "4.0"
        }
      }
    },
    "crossNavigation": {
      "inbounds": {
        "TravelPosting-manage": {
          "semanticObject": "TravelPosting",
          "action": "manage",
          "title": "{{TravelPosting-manage.flpTitle}}",
          "subTitle": "{{TravelPosting-manage.flpSubtitle}}",
          "signature": {
            "parameters": {},
            "additionalParameters": "allowed"
          }
        }
      }
    }
  },
  "sap.ui": {
    "technology": "UI5",
    "icons": {
      "icon": "",
      "favIcon": "",
      "phone": "",
      "phone@2": "",
      "tablet": "",
      "tablet@2": ""
    },
    "deviceTypes": {
      "desktop": true,
      "tablet": true,
      "phone": true
    }
  },
  "sap.ui5": {
    "flexEnabled": true,
    "dependencies": {
      "minUI5Version": "1.151.0",
      "libs": {
        "sap.m": {},
        "sap.ui.core": {},
        "sap.ui.layout": {},
        "sap.f": {},
        "sap.fe.core": {},
        "sap.fe.templates": {},
        "sap.ui.table": {},
        "sap.fe.macros": {},
        "sap.uxap": {}
      }
    },
    "contentDensities": {
      "compact": true,
      "cozy": true
    },
    "models": {
      "i18n": {
        "type": "sap.ui.model.resource.ResourceModel",
        "settings": {
          "bundleName": "delegacy-ui.i18n.i18n",
          "supportedLocales": [
            "",
            "hu"
          ],
          "fallbackLocale": ""
        }
      },
      "": {
        "dataSource": "mainService",
        "preload": true,
        "settings": {
          "operationMode": "Server",
          "autoExpandSelect": true,
          "earlyRequests": true
        }
      },
      "@i18n": {
        "type": "sap.ui.model.resource.ResourceModel",
        "uri": "i18n/i18n.properties",
        "settings": {
          "supportedLocales": [
            "",
            "hu"
          ],
          "fallbackLocale": ""
        }
      },
      "sectionNavigation": {
        "type": "sap.ui.model.json.JSONModel"
      }
    },
    "resources": {
      "css": [
        {
          "uri": "css/style.css"
        },
        {
          "uri": "css/tripData.css"
        }
      ]
    },
    "routing": {
      "config": {},
      "routes": [
        {
          "name": "Main",
          "pattern": ":?query:",
          "target": "Main"
        },
        {
          "name": "PostingsWithCarObjectPage",
          "pattern": "PostingsWithCar({PostingsWithCarKey}):?query:",
          "target": "PostingsWithCarObjectPage"
        },
        {
          "name": "PostingsRegularObjectPage",
          "pattern": "PostingsRegular({PostingsRegularKey}):?query:",
          "target": "PostingsRegularObjectPage"
        },
        {
          "name": "EmployeesObjectPage",
          "pattern": "Employees({EmployeesKey}):?query:",
          "target": "EmployeesObjectPage"
        }
      ],
      "targets": {
        "Main": {
          "type": "Component",
          "id": "Main",
          "name": "sap.fe.core.fpm",
          "options": {
            "settings": {
              "viewName": "delegacy-ui.ext.view.Main",
              "contextPath": "/PostingsWithCar",
              "navigation": {
                "PostingsWithCar": {
                  "detail": {
                    "route": "PostingsWithCarObjectPage"
                  }
                },
                "PostingsRegular": {
                  "detail": {
                    "route": "PostingsRegularObjectPage"
                  }
                },
                "Employees": {
                  "detail": {
                    "route": "EmployeesObjectPage"
                  }
                }
              }
            }
          }
        },
        "PostingsWithCarObjectPage": {
          "type": "Component",
          "id": "PostingsWithCarObjectPage",
          "name": "sap.fe.templates.ObjectPage",
          "options": {
            "settings": {
              "navigation": {},
              "contextPath": "/PostingsWithCar",
              "sectionLayout": "Tabs",
              "content": {
                "header": {
                  "actions": {
                    "savepdf": {
                      "press": "delegacy-ui.ext.controller.PDF_handler.handle",
                      "text": "{i18n>PreviewPDF}",
                      "position": {
                        "placement": "Before",
                        "anchor": "EditAction"
                      },
                      "enabled": "{= !${ui>/isEditable} && ${backOffice} && ${accepted}}",
                      "visible": "{= !${submittable} && ${backOffice} }"
                    }
                  }
                },
                "body": {
                  "sections": {
                    "Data": {
                      "template": "delegacy-ui.ext.fragment.TripData",
                      "title": "{i18n>TripData}",
                      "position": {
                        "placement": "After",
                        "anchor": "Cardata"
                      }
                    }
                  }
                },
                "footer": {
                  "actions": {
                    "previousSection": {
                      "text": "{i18n>PreviousSection}",
                      "press": "delegacy-ui.ext.controller.SectionNavigation.previous",
                      "enabled": "{sectionNavigation>/hasPrevious}",
                      "position": {
                        "placement": "Before",
                        "anchor": "DataFieldForAction::AppService.submit"
                      }
                    },
                    "nextSection": {
                      "text": "{i18n>NextSection}",
                      "press": "delegacy-ui.ext.controller.SectionNavigation.next",
                      "enabled": "{sectionNavigation>/hasNext}",
                      "position": {
                        "placement": "After",
                        "anchor": "previousSection"
                      }
                    }
                  }
                }
              },
              "controlConfiguration": {
                "stickers/@com.sap.vocabularies.UI.v1.LineItem#HighwayStickers": {
                  "columns": {
                    "DataField::country_code": {
                      "width": "18.5%"
                    },
                    "DataField::price": {
                      "width": "33%"
                    },
                    "DataField::currency_code": {
                      "width": "16.5%"
                    },
                    "DataField::date": {
                      "width": "16.5%"
                    }
                  },
                  "tableSettings": {
                    "creationMode": {
                      "createAtEnd": true
                    }
                  }
                },
                "attachments/@com.sap.vocabularies.UI.v1.LineItem#i18nAttachments": {
                  "columns": {
                    "DataField::content": {
                      "width": "68%"
                    },
                    "DataField::mimeType": {
                      "width": "34%"
                    }
                  }
                },
                "data/@com.sap.vocabularies.UI.v1.LineItem#Data": {
                  "columns": {
                    "DataField::date": {
                      "width": "9rem"
                    },
                    "DataField::from_postcode": {
                      "width": "6rem"
                    },
                    "DataField::from_city": {
                      "width": "10rem"
                    },
                    "DataField::from_where": {
                      "width": "13rem"
                    },
                    "DataField::from_client": {
                      "width": "10rem"
                    },
                    "DataField::to_postcode": {
                      "width": "6rem"
                    },
                    "DataField::to_city": {
                      "width": "10rem"
                    },
                    "DataField::to_where": {
                      "width": "13rem"
                    },
                    "DataField::to_client": {
                      "width": "10rem"
                    },
                    "DataField::mileage": {
                      "width": "9rem"
                    },
                    "DataField::daily_expense": {
                      "availability": "Hidden"
                    }
                  },
                  "tableSettings": {
                    "type": "GridTable",
                    "creationMode": {
                      "name": "Inline",
                      "createAtEnd": true
                    },
                    "enablePaste": true,
                    "enableExport": true,
                    "enableFullScreen": false
                  }
                }
              }
            }
          }
        },
        "PostingsRegularObjectPage": {
          "type": "Component",
          "id": "PostingsRegularObjectPage",
          "name": "sap.fe.templates.ObjectPage",
          "options": {
            "settings": {
              "navigation": {},
              "contextPath": "/PostingsRegular",
              "sectionLayout": "Tabs",
              "content": {
                "header": {
                  "actions": {
                    "saveRegularPDF": {
                      "id": "saveRegularPDF",
                      "press": "delegacy-ui.ext.controller.RegPDF_handler.downloadPDF",
                      "visible": "{= !${submittable} && ${backOffice} }",
                      "enabled": "{= !${ui>/isEditable} && ${backOffice} && ${accepted}}",
                      "text": "{i18n>PreviewPDF}",
                      "position": {
                        "placement": "Before",
                        "anchor": "EditAction"
                      }
                    }
                  }
                },
                "footer": {
                  "actions": {
                    "previousSection": {
                      "text": "{i18n>PreviousSection}",
                      "press": "delegacy-ui.ext.controller.SectionNavigation.previous",
                      "enabled": "{sectionNavigation>/hasPrevious}",
                      "position": {
                        "placement": "Before",
                        "anchor": "DataFieldForAction::AppService.submitRegular"
                      }
                    },
                    "nextSection": {
                      "text": "{i18n>NextSection}",
                      "press": "delegacy-ui.ext.controller.SectionNavigation.next",
                      "enabled": "{sectionNavigation>/hasNext}",
                      "position": {
                        "placement": "After",
                        "anchor": "previousSection"
                      }
                    }
                  }
                }
              },
              "controlConfiguration": {
                "departures_arrivals/@com.sap.vocabularies.UI.v1.LineItem#DeparturesandArrivals": {
                  "columns": {
                    "DataField::from_where": {
                      "width": "18%"
                    },
                    "DataField::departure": {
                      "availability": "Hidden"
                    },
                    "DataField::to_where": {
                      "width": "18%"
                    },
                    "DataField::arrival": {
                      "availability": "Hidden"
                    },
                    "DataField::meanOfTransport_ID": {
                      "width": "10%"
                    },
                    "DepartureMinutes": {
                      "header": "{i18n>Departure}",
                      "template": "delegacy-ui.ext.fragment.Departure",
                      "properties": [
                        "departure"
                      ],
                      "required": true,
                      "width": "15rem",
                      "position": {
                        "placement": "After",
                        "anchor": "DataField::from_where"
                      }
                    },
                    "ArrivalMinutes": {
                      "header": "{i18n>Arrival}",
                      "template": "delegacy-ui.ext.fragment.Arrival",
                      "properties": [
                        "arrival"
                      ],
                      "required": true,
                      "width": "15rem",
                      "position": {
                        "placement": "After",
                        "anchor": "DataField::to_where"
                      }
                    },
                    "TripMileage": {
                      "header": "{i18n>TripMileage}",
                      "template": "delegacy-ui.ext.fragment.TripMileage",
                      "properties": [
                        "mileage",
                        "meanOfTransport_ID"
                      ],
                      "width": "9rem",
                      "position": {
                        "placement": "After",
                        "anchor": "DataField::meanOfTransport_ID"
                      }
                    }
                  },
                  "tableSettings": {
                    "creationMode": {
                      "createAtEnd": true
                    }
                  }
                },
                "daily_expenses/@com.sap.vocabularies.UI.v1.LineItem#Dailyexpenses": {
                  "columns": {
                    "DataField::date": {
                      "width": "18.5%"
                    },
                    "DataField::days": {
                      "width": "14.5%"
                    },
                    "DataField::daily_price": {
                      "availability": "Hidden"
                    },
                    "DataField::currency_code": {
                      "width": "12%"
                    },
                    "DataField::paymentMethod_ID": {
                      "width": "14.5%"
                    },
                    "PerDiemAmount": {
                      "header": "{i18n>Amount}",
                      "template": "delegacy-ui.ext.fragment.PerDiem",
                      "properties": [
                        "daily_price",
                        "currency_code"
                      ],
                      "required": true,
                      "width": "17rem",
                      "position": {
                        "placement": "After",
                        "anchor": "DataField::days"
                      }
                    }
                  },
                  "tableSettings": {
                    "creationMode": {
                      "createAtEnd": true
                    }
                  }
                },
                "accomodations/@com.sap.vocabularies.UI.v1.LineItem#Accomodations": {
                  "columns": {
                    "DataField::accomodation_name": {
                      "width": "20%"
                    },
                    "DataField::date": {
                      "width": "10%"
                    },
                    "DataField::days": {
                      "width": "6%"
                    },
                    "DataField::daily_price": {
                      "width": "18%"
                    },
                    "DataField::currency_code": {
                      "width": "10%"
                    },
                    "DataField::paymentMethod_ID": {
                      "width": "10%"
                    },
                    "DataField::invoiceDate": {
                      "width": "10%"
                    }
                  },
                  "tableSettings": {
                    "creationMode": {
                      "createAtEnd": true
                    }
                  }
                },
                "material_expenses/@com.sap.vocabularies.UI.v1.LineItem#Materialexpenses": {
                  "columns": {
                    "DataField::reference": {
                      "width": "18%"
                    },
                    "DataField::date": {
                      "width": "12%"
                    },
                    "DataField::name": {
                      "width": "18%"
                    },
                    "DataField::price": {
                      "width": "14%"
                    },
                    "DataField::currency_code": {
                      "width": "6%"
                    },
                    "DataField::paymentMethod_ID": {
                      "width": "12%"
                    }
                  },
                  "tableSettings": {
                    "creationMode": {
                      "createAtEnd": true
                    }
                  }
                },
                "trip_expenses/@com.sap.vocabularies.UI.v1.LineItem#Tripexpenses": {
                  "columns": {
                    "DataField::currency_code": {
                      "width": "6%"
                    },
                    "DataField::paymentMethod_ID": {
                      "width": "12%"
                    },
                    "DataField::reference": {
                      "width": "18%"
                    },
                    "DataField::date": {
                      "width": "12%"
                    },
                    "DataField::name": {
                      "width": "18%"
                    },
                    "DataField::price": {
                      "width": "14%"
                    }
                  },
                  "tableSettings": {
                    "creationMode": {
                      "createAtEnd": true
                    }
                  }
                },
                "attachments/@com.sap.vocabularies.UI.v1.LineItem#i18nAttachments1": {
                  "columns": {
                    "DataField::content": {
                      "width": "68%"
                    },
                    "DataField::mimeType": {
                      "width": "37%"
                    }
                  }
                },
                "messages/@com.sap.vocabularies.UI.v1.LineItem#messages": {
                  "columns": {
                    "DataField::date": {
                      "width": "37%"
                    },
                    "DataField::message": {
                      "width": "37%"
                    }
                  }
                }
              }
            }
          }
        },
        "EmployeesObjectPage": {
          "type": "Component",
          "id": "EmployeesObjectPage",
          "name": "sap.fe.templates.ObjectPage",
          "options": {
            "settings": {
              "navigation": {},
              "contextPath": "/Employees",
              "sectionLayout": "Tabs"
            }
          }
        }
      }
    },
    "handleValidation": true,
    "extends": {
      "extensions": {
        "sap.ui.controllerExtensions": {
          "sap.fe.templates.ObjectPage.ObjectPageController": {
            "controllerName": "delegacy-ui.ext.controller.ObjectPage"
          }
        }
      }
    }
  },
  "sap.fe": {
    "app": {
      "enableLazyLoading": true
    }
  },
  "sap.cloud": {
    "public": true,
    "service": "kikuldetesek.service"
  },
  "sap.fiori": {
    "registrationIds": [],
    "archeType": "transactional"
  }
}
